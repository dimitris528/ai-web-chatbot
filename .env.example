# -----------------------------------------------------------------------------
# AI Web Chatbot configuration
# Copy to `.env` (never commit it) and fill in real values:  cp .env.example .env
# Every variable is optional except GROQ_API_KEY. Invalid values fail fast at startup.
# -----------------------------------------------------------------------------

# --- LLM provider (required) -------------------------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model id served by Groq (see https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b
# Sampling temperature, 0.0-2.0 (lower = more deterministic)
LLM_TEMPERATURE=0.7
# Maximum tokens generated per reply (reasoning models count reasoning tokens too)
LLM_MAX_TOKENS=2048
# Per-request timeout in seconds
LLM_TIMEOUT_SECONDS=30
# Automatic retries (exponential backoff) for 429/5xx/connection errors
LLM_MAX_RETRIES=2

# --- Conversation & context management ---------------------------------------
# Approximate token budget for system prompt + history + new message
CONTEXT_TOKEN_BUDGET=6000
# Hard cap on stored messages per session
MAX_HISTORY_MESSAGES=50
# Input limits enforced by the API and the UI
MAX_MESSAGE_CHARS=4000
MAX_SYSTEM_PROMPT_CHARS=2000
# Default persona (users can override it per browser in the UI)
# DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# --- Sessions -----------------------------------------------------------------
# Idle conversations are discarded after this many seconds
SESSION_TTL_SECONDS=3600
# Maximum concurrent conversations kept in memory (LRU eviction beyond this)
MAX_SESSIONS=1000

# --- Application --------------------------------------------------------------
# development | production | test
APP_ENV=development
# Signs session cookies. REQUIRED (32+ chars) in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
